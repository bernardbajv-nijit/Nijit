 * Pierwsza litera markera wyznacza stronę (np. A166 -> A, B112 -> B).
 * Kolejność ma znaczenie: wyjątki DR/PXD muszą być przed regułą bazową.
 */
const LANE_RULES = [
  // Wyjątki zależne od wariantu kierunku
  { side: 'B', re: /^DTM9-(?:DR2|PXD)(?:-|$)/ },
  { side: 'A', re: /^DTM9-DR1(?:-|$)/ },
  { side: 'B', re: /^NUE9-DR2(?:-|$)/ },
  { side: 'A', re: /^NUE9-DR1(?:-|$)/ },
  { side: 'B', re: /^NUE9-ATPOST[_-]KALSDORF[_-]AT-CC(?:-|$)/ },
  { side: 'A', re: /^NUE9-ATPO-KALSDORF-AT(?:-|$)/ },
  { side: 'A', re: /^BER8-DR1(?:-|$)/ },
  { side: 'B', re: /^BER8-DR2(?:-|$)/ },
  { side: 'B', re: /^HAJ8-DR1(?:-|$)/ },
  { side: 'A', re: /^HAJ8-DR2(?:-|$)/ },
  { side: 'A', re: /^PRG9-DR1(?:-|$)/ },
  { side: 'B', re: /^PRG9-DR2(?:-|$)/ },

  // Kierunki bazowe strony A
  { side: 'A', re: /^(?:DTM9|MHG9|NUE9|HAJ8|HHN9|LIL8)(?:-|$)/ },
  { side: 'A', re: /^(?:POPL)(?:-|$)/ },
  { side: 'A', re: /^DE\d+-DEPO(?:-|$)/ },
  { side: 'A', re: /^DEPO(?:-|$)/ },
  { side: 'A', re: /^AMZL-(?:DNW4|DBY8|DBY5)-ND(?:-|$)/ },

  // Kierunki bazowe strony B
  { side: 'B', re: /^(?:DTM8|MHG7|LEJ7|BER8|PRG9|MUC7|FRAX)(?:-|$)/ },
  { side: 'B', re: /^UPS(?:-|$)/ },
  { side: 'B', re: /^DP\d+-DP(?:-|$)/ },
  { side: 'B', re: /^DP-DE-H1(?:-|$)/ }
];

// agresywna normalizacja (ODM-proof)
function normalizeLaneText(str) {
  return String(str || '')
    .normalize('NFKD')
    .replace(/[^\x00-\x7E]/g, '')        // wywala dziwne unicode
    .replace(/[\u200B-\u200F\uFEFF]/g, '') // zero-width
    .replace(/[–—−]/g, '-')              // różne myślniki
    .replace(/\s+/g, '')                 // ODM czasem dodaje spacje
    .toUpperCase()
    .trim();
}

// usuwa TYLKO prefixy, suffixy zostają
function stripLanePrefix(afterArrow) {
  return afterArrow.replace(/^(LH|CC)[-_]?/i, '');
}

function extractLaneKey(fullLaneSanitized) {
  // groupKey zawiera po znaku nowej linii datę CPT – nie może brać udziału w dopasowaniu
  const pureLane = String(fullLaneSanitized || '').split('\n')[0].trim();
  const afterRaw = laneAfterArrow(sanitizeLaneStrong(pureLane));
  const stripped = stripLanePrefix(afterRaw);
  return normalizeLaneText(stripped);
}

function getLaneType(fullLaneSanitized) {
  const laneKey = extractLaneKey(fullLaneSanitized);
  const match = LANE_RULES.find(rule => rule.re.test(laneKey));

  return match ? match.side : '?';
}

function isLaneA(fullLaneSanitized) {
  return getLaneType(fullLaneSanitized) === 'A';
}

