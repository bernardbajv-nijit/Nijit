    s = s.replace(/[→⇒➔➜➝➞➟➠➤➧]/g, '->').replace(/\s*-\s*\>\s*/g, '->');
    s = s
      .replace(/[\u200B-\u200D\u2060\uFEFF]/g, '')
      .replace(/[\u202A-\u202E\u2066-\u2069\u200E\u200F\u061C]/g, '')
      .replace(/\u00A0/g, ' ')
      .replace(/[\x00-\x1F\x7F]/g, '');
    s = s.replace(/-?[A-Fa-f0-9]{8}-(?:[A-Fa-f0-9]{4}-){3}[A-Fa-f0-9]{12}(?=\b|$)/g, '');
    s = s.replace(/-?[A-Fa-f0-9]{32}(?=\b|$)/g, '');
    s = s.replace(/--+/g, '-')
      .replace(/-+\>/g, '->')
      .replace(/\>+-/g, '->')
      .replace(/\s+/g, ' ')
