  /***** Table helpers *****/
  function findMainTable(){
    return Array.from(document.querySelectorAll('table'))
      .find(t => Array.from(t.querySelectorAll('thead th')).some(th => /lane/i.test(norm(th.textContent))));
  }
  function buildHeaderGrid(table){
    const rows = [...table.querySelectorAll('thead tr')];
    if (!rows.length) return {leaves:[], groups:[]};
    const last = rows.at(-1);
    let cols = 0;
    for (const th of last.children) cols += +(th.getAttribute('colspan') || 1);
    const grid = Array.from({length: rows.length}, () => Array(cols).fill(null));
    for (let r=0; r<rows.length; r++){
      let cIndex = 0;
      for (const cell of rows[r].children){
        while(grid[r][cIndex]) cIndex++;
        const rs = +(cell.getAttribute('rowspan') || 1);
        const cs = +(cell.getAttribute('colspan') || 1);
        for (let rr=0; rr<rs; rr++){
          for (let cc=0; cc<cs; cc++){
            grid[r+rr][cIndex+cc] = { text: norm(cell.textContent) };
          }
        }
        cIndex += cs;
      }
    }
    const leaves = grid.at(-1).map((c,i)=>({colIndex:i,text:c?.text||''}));
    const groups = leaves.map(leaf=>{
      const path=[]; for(let r=0;r<grid.length;r++){
        const n=grid[r][leaf.colIndex]; if(!n) continue;
        if(!path.length || path.at(-1)!==n.text) path.push(n.text);
      }
      return{colIndex:leaf.colIndex,path,pathLower:path.map(x=>x.toLowerCase())};
    });
    return {leaves,groups};
  }
  function findLaneCol(table){
    const {groups} = buildHeaderGrid(table);
    for(const g of groups){ if(g.pathLower.some(x=>x.includes('lane'))) return g.colIndex; }
    return -1;
  }
  function findTimeLeftCol(table){
    const {groups} = buildHeaderGrid(table);
    for (const g of groups){
      const leaf = (g.path.at(-1) || '');
      const any = g.path.join(' ');
      if (/\btime\s*left\b/i.test(leaf) || /\btime\s*left\b/i.test(any)) return g.colIndex;
    }
    return -1;
  }
  function findCPTsCol(table){
    const { groups } = buildHeaderGrid(table);
    for (const g of groups){
      const leaf = (g.path.at(-1) || '').toLowerCase();
