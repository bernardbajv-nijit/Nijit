    }
    return -1;
  }

  function parseTimeLeftToMinutes(text){
    let t = String(text || '').trim();
    if (!t) return null;
    const hasMinus = /^[-\u2212]/.test(t) || /\blate\b/i.test(t);
    t = t.replace(/\blate\b/ig, '').replace(/^[-\u2212]\s*/, '').trim();
    let m = t.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
    if (m){
      const h = parseInt(m[1],10)||0, mm = parseInt(m[2],10)||0, ss = parseInt(m[3]||'0',10)||0;
      const mins = h*60 + mm + Math.floor(ss/60);
      return hasMinus ? -mins : mins;
    }
    let days=0,hours=0,mins=0, left=t;
    m = left.match(/(\d+)\s*d/i); if (m){ days=parseInt(m[1],10)||0; left=left.replace(m[0],''); }
    m = left.match(/(\d+)\s*h/i); if (m){ hours=parseInt(m[1],10)||0; left=left.replace(m[0],''); }
    m = left.match(/(\d+)\s*m(in)?/i); if (m){ mins=parseInt(m[1],10)||0; left=left.replace(m[0],''); }
    if (days||hours||mins){
      const total = days*24*60 + hours*60 + mins;
      return hasMinus ? -total : total;
    }
    m = t.match(/^(\d+)\s*$/);
    if (m){
      const total = parseInt(m[1],10)||0;
      return hasMinus ? -total : total;
    }
    return null;
  }
  function fmtMinutesHuman(mins){
    if (mins == null) return '—';
    const neg = mins < 0;
    const abs = Math.abs(mins);
    const d = Math.floor(abs / (24*60));
    const h = Math.floor((abs % (24*60)) / 60);
    const m = abs % 60;
    const core = d ? `${d}d ${h}h ${m}m` : (h ? `${h}h ${m}m` : `${m}m`);
    return neg ? `${core} Late` : core;
  }

  /***** Detect P metrics & roles *****/
  function detectPMetrics(table){
    const {groups} = buildHeaderGrid(table);
    const rows = [...table.querySelectorAll('tbody tr')];
    const sample = rows.slice(0,20);
    const metrics = [];
    for(const g of groups){
      const leaf = g.path.at(-1) || '';
      if(/^c:?$/i.test(leaf)) continue;
      if(/^p:?$/i.test(leaf)){ metrics.push({...g,mode:'pLeaf',label:g.path.join('_')+'_P'}); continue; }
      let mixed=0,checked=0;
      for(const r of sample){
        const c=r.querySelectorAll('td,th')[g.colIndex]; if(!c) continue;
        const txt=norm(c.textContent); checked++; if(/P\s*:/.test(txt)) mixed++;
      }
      if(checked && mixed/checked>=0.3){ metrics.push({...g,mode:'mixed',label:g.path.join('_')+'_P'}); }
    }
    for(const m of metrics){
      const path=(m.pathLower||[]).join(' '); let role=null;
      if(/\ball\b/.test(path)) role='ALL';
      if(/\bdivert/.test(path)) role='DIVERTED';
      if(/\bcontainer/.test(path)) role='CONTAINERIZED';
      if(/\bstaged\b/.test(path)) role='STAGED';
      if(/\bloaded/.test(path)) role='LOADED';
      if(/\bready\s*to\s*depart\b/.test(path)) role='READY_TO_DEPART';
      if(/\bdeparted\b/.test(path)) role='DEPARTED';
      m.role=role; m.normKey=(m.label||'').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');
    }
    return metrics;
  }

  /***** Aggregate (z Time Left) *****/
  function aggregate(table,laneCol,metrics,timeLeftCol){
    const cptsCol = findCPTsCol(table);
    const rows=[...table.querySelectorAll('tbody tr')];
    const map=new Map(); const totals={};
    for(const r of rows){
      const cells=r.querySelectorAll('td,th');
      if(!cells[laneCol]) continue;
      const laneLabel = fullLaneLabelFromCell(cells[laneCol].textContent);
      if(!laneLabel) continue;
      let dateText='';
      if (cptsCol>=0 && cells[cptsCol]){ dateText = norm(cells[cptsCol].textContent); }
      const groupKey = dateText ? `${laneLabel} \n${dateText}` : laneLabel;
      let rowObj=map.get(groupKey);
      if(!rowObj){rowObj={__lane: laneLabel, __date: dateText}; map.set(groupKey,rowObj);}
      for(const m of metrics){
        const cell=cells[m.colIndex]; if(!cell) continue;
        const txt=norm(cell.textContent);
        let val=m.mode==='pLeaf'?toInt(txt):parseP(txt);
        if(!val && /P\s*:/.test(txt)) val=parseP(txt);
        rowObj[m.normKey]=(rowObj[m.normKey]||0)+val;
        totals[m.normKey]=(totals[m.normKey]||0)+val;
      }
      if (typeof timeLeftCol === 'number' && timeLeftCol >= 0){
        const tlCell = cells[timeLeftCol];
        if (tlCell){
          const tlText = norm(tlCell.textContent);
          const tlMin = parseTimeLeftToMinutes(tlText);
          if (tlMin != null){
            rowObj.__minTL = (typeof rowObj.__minTL === 'number') ? Math.min(rowObj.__minTL, tlMin) : tlMin;
          }
        }
      }
    }
    return {entries:[...map.entries()], totals, metrics};
  }

  /***** Packages formula *****/
  function computePackages(agg){
    const role = (r)=>agg.metrics.find(m=>m.role===r);
    const ALL = role('ALL'),
          DIV = role('DIVERTED'),
          CON = role('CONTAINERIZED'),
          STG = role('STAGED'),
          LOD = role('LOADED'),
          RTD = role('READY_TO_DEPART');
    const KEY='all_remaining_p';
    if(!ALL) return{rows:[],totals:{},key:KEY,have:false};
    for(const[,obj] of agg.entries){
      const all=obj[ALL.normKey]||0;
      const sum = (DIV?obj[DIV.normKey]||0:0) + (CON?obj[CON.normKey]||0:0) + (STG?obj[STG.normKey]||0:0) + (LOD?obj[LOD.normKey]||0:0) + (RTD?obj[RTD.normKey]||0:0);
      obj[KEY] = all - sum;
    }
    agg.totals[KEY] = (agg.totals[ALL.normKey]||0) - ((DIV?agg.totals[DIV.normKey]||0:0) + (CON?agg.totals[CON.normKey]||0:0) + (STG?agg.totals[STG.normKey]||0:0) + (LOD?agg.totals[LOD.normKey]||0:0) + (RTD?agg.totals[RTD.normKey]||0:0));
    const rowsArr = agg.entries;
    return{rows:rowsArr,totals:agg.totals,key:KEY,have:true};
  }

  /***** KPI / animacje *****/
  function animateCount(el, to, duration = 200) {
    if (!el) return;
    const from = parseInt((el.dataset.prevValue || '0'), 10) || 0;
    const start = performance.now(); const diff = (to - from);
    function tick(now) {
      const t = Math.min(1, (now - start) / duration);
      const eased = t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t;
      const val = Math.round(from + diff * eased);
      el.textContent = val.toLocaleString('pl-PL');
      if (t < 1) requestAnimationFrame(tick); else el.dataset.prevValue = String(to);
    }
    requestAnimationFrame(tick);
  }
  function updateKPI(totalVal, maxLaneVal) {
    const totalEl = document.getElementById('kpiTotal');

    animateCount(totalEl, totalVal);
    const denom = Math.max(1, maxLaneVal || 1);
    const pct = Math.min(100, Math.round((totalVal / denom) * 100));

  }
  function updateLaneKPIs(sumA, sumB) {
    animateCount(document.getElementById('kpiLaneAVal'), sumA);
    animateCount(document.getElementById('kpiLaneBVal'), sumB);
  }

