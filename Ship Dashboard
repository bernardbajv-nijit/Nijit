/***** FLOWRATE (z innego skryptu) *****/
const FLOWRATE_KEY = 'flowrate_snapshot';

const FLOWRATE_URL = 'https://www.amazonlogistics.eu/sortcenter/flowrate';
const FLOWRATE_STALE_MS = 2 * 60 * 1000; // 2 min
let lastFlowrateOpen = 0;
let flowrateTab = null;
let managedTabs = [];

const FLOWRATE_ALIVE_MS = 90 * 1000; // 1.5 min

function closeAllManagedTabs() {
    managedTabs = managedTabs.filter(tab => {
        try {
            if (tab && !tab.closed) {
                tab.close();
                return false;
            }
        } catch (e) {
            console.warn('Close tab error', e);
        }
        return false;
    });
}

function isFlowrateAlive() {
  const last = Number(localStorage.getItem('flowrate_alive'));
  if (!last) return false;
  return Date.now() - last < FLOWRATE_ALIVE_MS;
}

function ensureFlowrateIfStale() {
    const now = Date.now();

    // Jeśli Flowrate żyje – nic nie rób
    if (isFlowrateAlive()) {
        return;
    }

    // throttle 5 min
    if (now - lastFlowrateOpen <= 5 * 60 * 1000) {
        return;
    }

    console.log('[Dashboard] Flowrate inactive → opening tab');

    lastFlowrateOpen = now;
  // ✅ Zamknij WSZYSTKIE stare zakładki otwarte przez skrypt
closeAllManagedTabs();

    // ✅ Otwórz nową i zapamiętaj uchwyt
  flowrateTab = GM_openInTab(FLOWRATE_URL, {
    active: false,
    insert: true,
});

managedTabs.push(flowrateTab);

}

